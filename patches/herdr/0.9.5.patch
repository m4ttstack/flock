+#[cfg(unix)]
+fn control_terminal(
+    server: &mut HeadlessServer,
+    client_id: u64,
+    terminal_id: &crate::terminal::TerminalId,
+) {
+    connect_pending_terminal_client(server, client_id);
+    assert!(
+        server.handle_server_event(ServerEvent::ClientControlTerminal {
+            client_id,
+            target: terminal_id.to_string(),
+            takeover: false,
+        })
+    );
+}
