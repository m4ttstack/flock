+#[test]
+fn terminal_control_mouse_command_maps_button_kinds_to_attach_mouse() {
+    for (kind, expected) in [
+        ("down", ClientMouseKind::Down(ClientMouseButton::Right)),
+        ("up", ClientMouseKind::Up(ClientMouseButton::Right)),
+        ("drag", ClientMouseKind::Drag(ClientMouseButton::Right)),
+    ] {
+        let action = terminal_control_command_from_json(&format!(
+            r#"{{"type":"terminal.mouse","kind":"{kind}","button":"right","column":9,"row":4,"modifiers":2}}"#
+        ))
+        .unwrap();
+        let ClientMessage::AttachMouse {
+            kind,
+            position,
+            geometry,
+            modifiers,
+            lines,
+        } = action
+        else {
+            panic!("expected attach mouse command");
+        };
+        assert_eq!(kind, expected);
+        assert_eq!(position, ClientMousePosition::Cell { column: 9, row: 4 });
+        assert_eq!(geometry, None);
+        assert_eq!(modifiers, 2);
+        assert_eq!(lines, 1);
+    }
+}
+
+#[test]
+fn terminal_control_mouse_command_maps_buttonless_kinds_and_lines() {
+    for (kind, expected) in [
+        ("moved", ClientMouseKind::Moved),
+        ("scroll_up", ClientMouseKind::ScrollUp),
+        ("scroll_down", ClientMouseKind::ScrollDown),
+        ("scroll_left", ClientMouseKind::ScrollLeft),
+        ("scroll_right", ClientMouseKind::ScrollRight),
+    ] {
+        let action = terminal_control_command_from_json(&format!(
+            r#"{{"type":"terminal.mouse","kind":"{kind}","column":0,"row":0,"lines":3}}"#
+        ))
+        .unwrap();
+        let ClientMessage::AttachMouse {
+            kind,
+            position,
+            modifiers,
+            lines,
+            ..
+        } = action
+        else {
+            panic!("expected attach mouse command");
+        };
+        assert_eq!(kind, expected);
+        assert_eq!(position, ClientMousePosition::Cell { column: 0, row: 0 });
+        assert_eq!(modifiers, 0);
+        assert_eq!(lines, 3);
+    }
+}
+
+#[test]
+fn terminal_control_mouse_command_accepts_every_button_name() {
+    for (name, expected) in [
+        ("left", ClientMouseButton::Left),
+        ("middle", ClientMouseButton::Middle),
+        ("right", ClientMouseButton::Right),
+    ] {
+        let action = terminal_control_command_from_json(&format!(
+            r#"{{"type":"terminal.mouse","kind":"down","button":"{name}","column":1,"row":1}}"#
+        ))
+        .unwrap();
+        let ClientMessage::AttachMouse { kind, .. } = action else {
+            panic!("expected attach mouse command");
+        };
+        assert_eq!(kind, ClientMouseKind::Down(expected));
+    }
+}
+
+#[test]
+fn terminal_control_mouse_command_rejects_missing_button_and_bad_names() {
+    let err = terminal_control_command_from_json(
+        r#"{"type":"terminal.mouse","kind":"down","column":1,"row":1}"#,
+    )
+    .unwrap_err();
+    assert_eq!(err, "terminal.mouse down requires a button");
+
+    let err = terminal_control_command_from_json(
+        r#"{"type":"terminal.mouse","kind":"drag","column":1,"row":1}"#,
+    )
+    .unwrap_err();
+    assert_eq!(err, "terminal.mouse drag requires a button");
+
+    let err = terminal_control_command_from_json(
+        r#"{"type":"terminal.mouse","kind":"tap","button":"left","column":1,"row":1}"#,
+    )
+    .unwrap_err();
+    assert!(
+        err.starts_with("invalid json command: unknown variant `tap`"),
+        "{err}"
+    );
+
+    let err = terminal_control_command_from_json(
+        r#"{"type":"terminal.mouse","kind":"down","button":"back","column":1,"row":1}"#,
+    )
+    .unwrap_err();
+    assert!(
+        err.starts_with("invalid json command: unknown variant `back`"),
+        "{err}"
+    );
+
+    let err = terminal_control_command_from_json(
+        r#"{"type":"terminal.mouse","kind":"scroll_up","column":1,"row":1,"lines":0}"#,
+    )
+    .unwrap_err();
+    assert_eq!(err, "terminal.mouse lines must be greater than 0");
+}
